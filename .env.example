DATABASE_URL="file:./dev.db?connection_limit=1&socket_timeout=20"
JWT_SECRET="ganti-dengan-secret-acak-yang-panjang"

# Redis dipakai untuk: (1) adapter Socket.IO lintas instance, (2) penghitung presence online
REDIS_URL="redis://localhost:6379"

# Port server custom (Next.js + Socket.IO). Jalankan beberapa instance dengan
# PORT berbeda untuk mendemonstrasikan broadcast lintas instance.
PORT=3000
